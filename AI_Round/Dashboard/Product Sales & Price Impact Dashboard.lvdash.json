{
  "datasets": [
    {
      "name": "orders_summary",
      "displayName": "Orders Summary Metrics",
      "config": {
        "version": "1.1",
        "source": "product.gold.orders_summary",
        "dimensions": [
          {
            "name": "month",
            "expr": "DATE_TRUNC('month', order_date)",
            "displayName": "Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          },
          {
            "name": "product_id",
            "expr": "product_id",
            "displayName": "Product ID"
          },
          {
            "name": "product_price",
            "expr": "product_price",
            "displayName": "Price"
          }
        ],
        "measures": [
          {
            "name": "total_products_sold",
            "expr": "SUM(total_products_sold)",
            "displayName": "Total Products Sold"
          },
          {
            "name": "total_amount",
            "expr": "SUM(total_amount)",
            "displayName": "Total Amount"
          },
          {
            "name": "no_of_orders",
            "expr": "SUM(no_of_orders)",
            "displayName": "No. of Orders"
          }
        ]
      }
    },
    {
      "name": "price_impact",
      "displayName": "Price Impact Analysis",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  o.order_date,\n  o.product_id,\n  o.product_name,\n  o.no_of_orders,\n  o.total_products_sold,\n  o.total_amount,\n  p.price AS scd2_price\nFROM product.gold.orders_summary o JOIN product.silver.products p\n  ON o.product_id = p.product_id\n  AND DATE_TRUNC('month', o.order_date) >= p.start_date\n  AND (p.end_date IS NULL OR DATE_TRUNC('month', o.order_date) <= p.end_date)\n",
        "dimensions": [
          {
            "name": "month",
            "expr": "DATE_TRUNC('month', order_date)",
            "displayName": "Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "product_id",
            "expr": "product_id",
            "displayName": "Product ID"
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          },
          {
            "name": "scd2_price",
            "expr": "scd2_price",
            "displayName": "Price (SCD2)"
          }
        ],
        "measures": [
          {
            "name": "total_products_sold",
            "expr": "SUM(total_products_sold)",
            "displayName": "Total Products Sold"
          },
          {
            "name": "no_of_orders",
            "expr": "SUM(no_of_orders)",
            "displayName": "No. of Orders"
          },
          {
            "name": "total_amount",
            "expr": "SUM(total_amount)",
            "displayName": "Total Amount"
          },
          {
            "name": "avg_price",
            "expr": "AVG(scd2_price)",
            "displayName": "Avg Price (SCD2)"
          }
        ]
      }
    }
  ],
